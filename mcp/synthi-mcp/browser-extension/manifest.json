{
  "manifest_version": 3,
  "name": "Synthi Browser Bridge",
  "version": "0.1.0",
  "description": "Explicit teach-mode bridge for Synthi browser MCP sessions.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-teach": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle Synthi teach mode overlay"
    }
  }
}
