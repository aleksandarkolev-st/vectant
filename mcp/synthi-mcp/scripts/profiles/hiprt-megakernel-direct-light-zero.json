{
  "schemaVersion": "synthi.gpu.hmr.runtime_profile.v1",
  "id": "hiprt-megakernel-direct-light-zero",
  "adapter": {
    "family": "hiprt-path-tracer",
    "proofRunner": "hiprt-warm-visual",
    "capabilities": [
      "same-process-reload",
      "runtime-framebuffer-readback",
      "native-launch-observation"
    ]
  },
  "runtime": {
    "targetName": "HIPRTPathTracer",
    "args": [
      "../data/GLTFs/cornell_pbr.gltf",
      "--sky=../data/Skyspheres/evening_road_01_puresky_2k.hdr"
    ],
    "requiredFiles": [
      "data/GLTFs/cornell_pbr.gltf",
      "data/Skyspheres/evening_road_01_puresky_2k.hdr"
    ],
    "requiredKernels": [
      "CameraRays",
      "MegaKernel"
    ],
    "reload": {
      "kernelName": "Megakernel (1 SPP)",
      "kernelSymbol": "MegaKernel"
    }
  },
  "source": {
    "file": "src/Device/kernels/Megakernel.h",
    "before": "ray_payload.ray_color += estimate_direct_lighting(render_data, ray_payload, closest_hit_info, -ray.direction, x, y, random_number_generator);",
    "after": "ray_payload.ray_color += estimate_direct_lighting(render_data, ray_payload, closest_hit_info, -ray.direction, x, y, random_number_generator) * 0.0f;"
  },
  "visualProof": {
    "claim": "A HIPRT MegaKernel direct-lighting math delta materially changes the ray-traced framebuffer.",
    "width": 640,
    "height": 360,
    "minChangedPixelRatio": 0.05,
    "minMeanAbsDelta8bit": 1.0
  },
  "deterministicVisualMode": {
    "fixedSeed": "42",
    "frozenCamera": true,
    "temporalAccumulationDisabled": true,
    "taaDisabled": true,
    "denoiserDisabled": true,
    "fixedResolution": true,
    "presentationFenceOrFrameBoundary": "runtime-framebuffer-capture-after-kernel-dispatch",
    "warmupFrames": 1,
    "convergenceWindow": {
      "frameStart": 1,
      "frameEnd": 1,
      "metric": "per_frame_delta"
    },
    "notes": [
      "Camera state and random_number are set by the same-process probe before the proof frame.",
      "Denoising/postprocess must not satisfy visual proof unless this mode is explicitly enforced by the adapter."
    ]
  },
  "proof": {
    "requireStrictProvenance": true
  }
}
