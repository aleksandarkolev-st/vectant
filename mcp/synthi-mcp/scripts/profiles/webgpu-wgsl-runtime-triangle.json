{
  "schemaVersion": "synthi.gpu.hmr.webgpu_visual_profile.v1",
  "id": "webgpu-wgsl-runtime-triangle",
  "project": {
    "name": "WebGPU WGSL runtime visual HMR proof",
    "kind": "gpu_project"
  },
  "canvas": {
    "width": 640,
    "height": 360
  },
  "shader": {
    "artifactKind": "wgsl",
    "beforePath": "webgpu/triangle-before.wgsl",
    "afterPath": "webgpu/triangle-after.wgsl",
    "entryPoints": {
      "vertex": "vs",
      "fragment": "fs"
    },
    "draw": {
      "vertexCount": 3
    }
  },
  "pipeline": {
    "layout": "explicit-empty",
    "primitiveTopology": "triangle-list",
    "bindGroupLayouts": [],
    "vertexBufferLayouts": [],
    "colorTargetState": {
      "format": "preferredCanvasFormat",
      "alphaMode": "opaque"
    }
  },
  "visualProof": {
    "claim": "Replacing the WGSL shader module and recreating the WebGPU render pipeline in the same browser page changes the rendered frame.",
    "minChangedPixelRatio": 0.02,
    "minMeanAbsDelta8bit": 1.0
  },
  "deterministicVisualMode": {
    "fixedSeed": "webgpu-no-random-input",
    "seedPolicyFixed": true,
    "frozenCamera": true,
    "temporalAccumulationNotApplicable": true,
    "taaNotApplicable": true,
    "denoiserNotApplicable": true,
    "fixedResolution": true,
    "fixedSwapchainImageCount": true,
    "frameCaptureAfterEpochDispatch": true,
    "presentationFenceOrFrameBoundary": true,
    "warmupFrames": 0
  }
}
