{
  "name": "@synthi-inc/mcp-server",
  "version": "0.1.0",
  "private": false,
  "description": "Synthi MCP — proprietary MCP server for agents to observe and drive a running Synthi preview session.",
  "type": "module",
  "bin": {
    "synthi-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source-identity": {
      "types": "./dist/browser/source_identity.d.ts",
      "import": "./dist/browser/source_identity.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/lib",
    "scripts/lib/gpu-hmr-acceptance-contract.mjs",
    "scripts/lib/gpu-hmr-validation-matrix-ledger.mjs",
    "scripts/gpu-hmr-real-rocm-repo-validation.mjs",
    "scripts/gpu-hmr-random-large-project-cold-path.mjs",
    "scripts/gpu-hmr-runtime-profile-proof.mjs",
    "scripts/gpu-hmr-validation-matrix-ledger.mjs",
    "scripts/gpu-hmr-webgpu-preflight.mjs",
    "scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs",
    "scripts/gpu-hmr-webgpu-runtime-compute-proof.mjs",
    "scripts/gpu-hmr-hip-module-runtime-proof.mjs",
    "scripts/gpu-hmr-hiprt-target-progression-probe.mjs",
    "scripts/gpu-hmr-oidn-preflight.mjs",
    "scripts/gpu-hmr-opencl-preflight.mjs",
    "scripts/gpu-hmr-opencl-runtime-proof.mjs",
    "scripts/gpu-hmr-vulkan-preflight.mjs",
    "scripts/gpu-hmr-vulkan-runtime-proof.mjs",
    "scripts/gpu-hmr-agent-split-workspace-test.mjs",
    "scripts/gpu-hmr-source-first-visual-proof.mjs",
    "scripts/gpu-hmr-external-project-profile.mjs",
    "scripts/gpu-hmr-timing-metrics-summary.mjs",
    "scripts/hiprt-light-math-warm-proof.mjs",
    "scripts/probes/hip_module_runtime_probe.cpp",
    "scripts/probes/hiprt_target_progression_host.cpp",
    "scripts/probes/hiprt_testcopy_kernel_wrapper.hip",
    "scripts/profiles/hiprt-*.json",
    "scripts/profiles/agent-*.json",
    "scripts/profiles/real-rocm-*.json",
    "scripts/profiles/hip-module-runtime-*.json",
    "scripts/profiles/hip-module/*.hip",
    "scripts/profiles/webgpu-wgsl-runtime-triangle.json",
    "scripts/profiles/webgpu-wgsl-runtime-triangle-hot2.json",
    "scripts/profiles/webgpu-wgsl-runtime-profiled-layout.json",
    "scripts/profiles/webgpu-wgsl-runtime-profiled-layout-hot2.json",
    "scripts/profiles/webgpu-wgsl-runtime-compute-storage.json",
    "scripts/profiles/webgpu-wgsl-runtime-compute-storage-hot2.json",
    "scripts/profiles/webgpu/triangle-before.wgsl",
    "scripts/profiles/webgpu/triangle-after.wgsl",
    "scripts/profiles/webgpu/triangle-after-hot2.wgsl",
    "scripts/profiles/webgpu/profiled-before.wgsl",
    "scripts/profiles/webgpu/profiled-after.wgsl",
    "scripts/profiles/webgpu/profiled-after-hot2.wgsl",
    "scripts/profiles/webgpu/compute-before.wgsl",
    "scripts/profiles/webgpu/compute-after.wgsl",
    "scripts/profiles/webgpu/compute-after-hot2.wgsl",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthi-inc/synthi-ide.git",
    "directory": "mcp/synthi-mcp"
  },
  "homepage": "https://github.com/synthi-inc/synthi-ide/tree/main/mcp/synthi-mcp#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "browser:workflow:bridge": "node dist/browser_workflow_bridge/standalone.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/release-smoke.mjs --command dist/index.js",
    "smoke:image": "node scripts/release-smoke.mjs",
    "spike:all": "tsx tests/spike/run_all.ts",
    "spike:E1": "tsx tests/spike/E1_frame_seq.ts",
    "spike:E2": "tsx tests/spike/E2_locator_cache.ts",
    "spike:E2b": "tsx tests/spike/E2b_region_phash.ts",
    "spike:E3": "tsx tests/spike/E3_p99_load.ts",
    "spike:E4": "tsx tests/spike/E4_cost_budget.ts",
    "soak": "node tests/soak/soak_loop.mjs",
    "live:phase3": "node scripts/live-test-phase3.mjs",
    "live:browser": "node scripts/live-browser-smoke.mjs",
    "live:browser:workspace": "node scripts/live-browser-smoke.mjs --workspace",
    "live:browser:workflow-pipeline": "node scripts/workflow-pipeline-e2e.mjs",
    "live:browser:install": "npx playwright-core install chromium",
    "smoke:operator-agents": "node scripts/operator-multi-agent-smoke.mjs",
    "live:lease-contention": "node scripts/live-lease-contention.mjs",
    "proof:real-rocm": "node scripts/gpu-hmr-real-rocm-repo-validation.mjs",
    "proof:real-rocm:self-check": "node scripts/gpu-hmr-real-rocm-repo-validation.mjs --self-check",
    "proof:real-rocm:package-scripts:self-check": "node scripts/tests/gpu-hmr-real-rocm-package-scripts-smoke.mjs",
    "proof:real-rocm:warm": "node -e \"process.env.SYNTHI_REAL_ROCM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/real-rocm-saxpy.json'; process.env.SYNTHI_REAL_ROCM_REUSE_WORKER_REPO='1'; process.env.SYNTHI_REAL_ROCM_CLEAN_BUILD='0'; import('./scripts/gpu-hmr-real-rocm-repo-validation.mjs')\"",
    "proof:real-rocm:matrix-multiplication": "node -e \"process.env.SYNTHI_REAL_ROCM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/real-rocm-matrix-multiplication.json'; process.env.SYNTHI_VALIDATION_AUTHLESS_WORKSPACE='1'; process.env.SYNTHI_REAL_ROCM_COMPILE_TRANSPORT='workspace-ref'; process.env.SYNTHI_REAL_ROCM_REQUIRE_FULL_RUNTIME_PROOF='1'; process.env.SYNTHI_REAL_ROCM_REQUIRE_ORIGINAL_HOST_PATH_PROOF='1'; process.env.SYNTHI_REAL_ROCM_NATIVE_LAUNCH_OBSERVER='1'; import('./scripts/gpu-hmr-real-rocm-repo-validation.mjs')\"",
    "proof:real-rocm:large-ml-miopen": "node -e \"process.env.SYNTHI_REAL_ROCM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/real-rocm-miopen-activation-large-ml.json'; process.env.SYNTHI_VALIDATION_AUTHLESS_WORKSPACE='1'; process.env.SYNTHI_REAL_ROCM_COMPILE_TRANSPORT='workspace-ref'; process.env.SYNTHI_REAL_ROCM_REQUIRE_FULL_RUNTIME_PROOF='1'; process.env.SYNTHI_REAL_ROCM_REQUIRE_ORIGINAL_HOST_PATH_PROOF='1'; process.env.SYNTHI_REAL_ROCM_NATIVE_LAUNCH_OBSERVER='1'; process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_SOURCE ??= (process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_MS === undefined ? 'package_default' : 'caller_env'); process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_MS ??= '7200000'; import('./scripts/gpu-hmr-real-rocm-repo-validation.mjs')\"",
    "proof:real-rocm:large-ml-composable-kernel": "node -e \"process.env.SYNTHI_REAL_ROCM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/real-rocm-composable-kernel-gemm-large-ml.json'; process.env.SYNTHI_VALIDATION_AUTHLESS_WORKSPACE='1'; process.env.SYNTHI_REAL_ROCM_COMPILE_TRANSPORT='workspace-ref'; process.env.SYNTHI_REAL_ROCM_REQUIRE_FULL_RUNTIME_PROOF='1'; process.env.SYNTHI_REAL_ROCM_REQUIRE_ORIGINAL_HOST_PATH_PROOF='1'; process.env.SYNTHI_REAL_ROCM_NATIVE_LAUNCH_OBSERVER='1'; process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_SOURCE ??= (process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_MS === undefined ? 'package_default' : 'caller_env'); process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_MS ??= '7200000'; import('./scripts/gpu-hmr-real-rocm-repo-validation.mjs')\"",
    "proof:real-rocm:large-ml-hipblaslt": "node -e \"process.env.SYNTHI_REAL_ROCM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/real-rocm-hipblaslt-gelu-aux-bias-large-ml.json'; process.env.SYNTHI_VALIDATION_AUTHLESS_WORKSPACE='1'; process.env.SYNTHI_REAL_ROCM_COMPILE_TRANSPORT='workspace-ref'; process.env.SYNTHI_REAL_ROCM_REQUIRE_FULL_RUNTIME_PROOF='1'; process.env.SYNTHI_REAL_ROCM_REQUIRE_ORIGINAL_HOST_PATH_PROOF='1'; process.env.SYNTHI_REAL_ROCM_NATIVE_LAUNCH_OBSERVER='1'; process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_SOURCE ??= (process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_MS === undefined ? 'package_default' : 'caller_env'); process.env.SYNTHI_REAL_ROCM_UPSTREAM_TIMEOUT_MS ??= '7200000'; import('./scripts/gpu-hmr-real-rocm-repo-validation.mjs')\"",
    "proof:random-large-project:cold": "node scripts/gpu-hmr-random-large-project-cold-path.mjs --require-direct-source",
    "proof:random-large-project:cold:sample-pool": "node scripts/gpu-hmr-random-large-project-cold-path.mjs --sample-pool",
    "proof:random-large-project:cold:dry-run": "node scripts/gpu-hmr-random-large-project-cold-path.mjs --dry-run --sample-pool",
    "proof:random-large-project:cold:self-check": "node scripts/gpu-hmr-random-large-project-cold-path.mjs --self-check",
    "proof:runtime-profile": "node scripts/gpu-hmr-runtime-profile-proof.mjs",
    "proof:runtime-profile:self-check": "node scripts/gpu-hmr-runtime-profile-proof.mjs --self-check",
    "proof:runtime-boundary-adapter:self-check": "node scripts/tests/gpu-hmr-runtime-boundary-proof-adapter-smoke.mjs",
    "proof:adversarial-ledger:self-check": "node scripts/gpu-hmr-adversarial-proof-ledger-self-check.mjs",
    "proof:acceptance-contract:self-check": "node scripts/gpu-hmr-acceptance-contract-self-check.mjs",
    "proof:strict-gates:self-check": "node scripts/gpu-hmr-proof-strict-gates-self-check.mjs",
    "proof:visual-evidence:self-check": "node scripts/tests/gpu-hmr-visual-evidence-smoke.mjs",
    "proof:visual-proof-worker:self-check": "node scripts/tests/gpu-hmr-visual-proof-worker-smoke.mjs",
    "proof:artifact-cas:self-check": "node scripts/tests/gpu-hmr-artifact-cas-smoke.mjs",
    "proof:generated-split-granularity:self-check": "node scripts/tests/gpu-hmr-generated-split-granularity-smoke.mjs",
    "proof:agent-split:source-first": "node scripts/gpu-hmr-agent-split-workspace-test.mjs",
    "proof:agent-split:source-first:self-check": "node scripts/gpu-hmr-agent-split-workspace-test.mjs --self-check",
    "proof:agent-split:source-first:seed-only": "node -e \"process.env.SYNTHI_GPU_AGENT_MODE='seed-only'; process.env.SYNTHI_GPU_VENDOR ??= 'rocm'; process.env.SYNTHI_SYNC_TO_GCS ??= '0'; process.env.SYNTHI_VALIDATION_AUTHLESS_WORKSPACE ??= '1'; import('./scripts/gpu-hmr-agent-split-workspace-test.mjs')\"",
    "proof:agent-split:source-first:realistic-raytrace": "node -e \"process.env.SYNTHI_GPU_AGENT_PROFILE_PATH ??= 'scripts/profiles/agent-realistic-raytrace-scene.json'; process.env.SYNTHI_GPU_AGENT_CAPTURE_ARTIFACTS ??= '1'; process.env.SYNTHI_SYNC_TO_GCS ??= '0'; process.env.SYNTHI_VALIDATION_AUTHLESS_WORKSPACE ??= '1'; process.env.SYNTHI_GPU_VENDOR ??= 'rocm'; import('./scripts/gpu-hmr-agent-split-workspace-test.mjs')\"",
    "proof:source-first:visual": "node scripts/gpu-hmr-source-first-visual-proof.mjs",
    "proof:source-first:visual:self-check": "node scripts/gpu-hmr-source-first-visual-proof.mjs --self-check",
    "proof:flow:source-first:visual": "node scripts/gpu-hmr-source-first-visual-proof.mjs --fixture flow",
    "proof:rocm:source-first:realistic-visual": "node scripts/gpu-hmr-source-first-visual-proof.mjs --profile scripts/profiles/agent-realistic-raytrace-scene.json",
    "proof:external-project": "node scripts/gpu-hmr-external-project-profile.mjs",
    "proof:external-project:self-check": "node scripts/gpu-hmr-external-project-profile.mjs --self-check",
    "proof:external-project:dry-run": "node scripts/gpu-hmr-external-project-profile.mjs --dry-run --profile mcp/synthi-mcp/scripts/profiles/threejs-webgl-shader-lava.json",
    "proof:timing-metrics": "node scripts/gpu-hmr-timing-metrics-summary.mjs",
    "proof:validation-matrix": "node scripts/gpu-hmr-validation-matrix-ledger.mjs",
    "proof:validation-matrix:history": "node scripts/gpu-hmr-validation-matrix-ledger.mjs --include-unproven --output-dir .gpu-hmr-test-logs/validation-matrix-unproven-audit",
    "proof:validation-matrix:self-check": "node scripts/tests/gpu-hmr-validation-matrix-ledger-smoke.mjs && node scripts/gpu-hmr-validation-matrix-ledger.mjs --self-check",
    "proof:status-docs:self-check": "node scripts/tests/gpu-hmr-status-docs-freshness-smoke.mjs",
    "proof:external-project:bevy": "node scripts/gpu-hmr-external-project-profile.mjs --profile mcp/synthi-mcp/scripts/profiles/bevy-wgsl-shader-material.json",
    "proof:timing-metrics:self-check": "node scripts/tests/gpu-hmr-timing-metrics-smoke.mjs && node scripts/gpu-hmr-timing-metrics-summary.mjs --self-check",
    "proof:runtime-profile:hiprt": "node scripts/gpu-hmr-runtime-profile-proof.mjs --profile mcp/synthi-mcp/scripts/profiles/hiprt-megakernel-direct-light-zero.json --mode same-process",
    "proof:runtime-profile:hiprt:camera-rays": "node scripts/gpu-hmr-runtime-profile-proof.mjs --profile mcp/synthi-mcp/scripts/profiles/hiprt-camera-rays-horizontal-mirror.json --mode same-process",
    "proof:runtime-profile:hiprt:megakernel-light-gain": "node scripts/gpu-hmr-runtime-profile-proof.mjs --profile mcp/synthi-mcp/scripts/profiles/hiprt-megakernel-direct-light-gain.json --mode same-process",
    "proof:hiprt:warm": "node scripts/hiprt-light-math-warm-proof.mjs",
    "proof:hiprt:warm:camera-rays": "node -e \"process.env.SYNTHI_HIPRT_WARM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/hiprt-camera-rays-horizontal-mirror.json'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:hiprt:warm:megakernel-light-gain": "node -e \"process.env.SYNTHI_HIPRT_WARM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/hiprt-megakernel-direct-light-gain.json'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:hiprt:same-process": "node -e \"process.env.SYNTHI_HIPRT_WARM_MODE='same-process'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:hiprt:same-process:camera-rays": "node -e \"process.env.SYNTHI_HIPRT_WARM_MODE='same-process'; process.env.SYNTHI_HIPRT_WARM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/hiprt-camera-rays-horizontal-mirror.json'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:hiprt:same-process:megakernel-light-gain": "node -e \"process.env.SYNTHI_HIPRT_WARM_MODE='same-process'; process.env.SYNTHI_HIPRT_WARM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/hiprt-megakernel-direct-light-gain.json'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:hiprt:runtime-boundary:self-check": "node scripts/hiprt-light-math-warm-proof.mjs --runtime-boundary-app-hook-self-check",
    "proof:hiprt:target-progression:self-check": "node scripts/gpu-hmr-hiprt-target-progression-probe.mjs --self-check",
    "proof:oidn:preflight": "node scripts/gpu-hmr-oidn-preflight.mjs",
    "proof:oidn:preflight:self-check": "node scripts/gpu-hmr-oidn-preflight.mjs --self-check",
    "proof:oidn:output-oracle:self-check": "node scripts/gpu-hmr-oidn-preflight.mjs --output-oracle-self-check",
    "proof:oidn:runtime:self-check": "node scripts/gpu-hmr-oidn-preflight.mjs --runtime-boundary-self-check",
    "proof:opencl:preflight": "node scripts/gpu-hmr-opencl-preflight.mjs",
    "proof:opencl:preflight:self-check": "node scripts/gpu-hmr-opencl-preflight.mjs --self-check",
    "proof:opencl:runtime": "node scripts/gpu-hmr-opencl-runtime-proof.mjs",
    "proof:opencl:runtime:hot2": "node -e \"process.env.SYNTHI_OPENCL_RUNTIME_METRIC_SCOPE='hot_delta_2'; process.env.SYNTHI_OPENCL_RUNTIME_DIFFERENT_EDIT='1'; process.env.SYNTHI_OPENCL_RUNTIME_AFTER_MULTIPLIER='4'; process.env.SYNTHI_OPENCL_RUNTIME_AFTER_BIAS='1.25'; import('./scripts/gpu-hmr-opencl-runtime-proof.mjs')\"",
    "proof:opencl:runtime:self-check": "node scripts/gpu-hmr-opencl-runtime-proof.mjs --self-check",
    "proof:vulkan:preflight": "node scripts/gpu-hmr-vulkan-preflight.mjs",
    "proof:vulkan:preflight:self-check": "node scripts/gpu-hmr-vulkan-preflight.mjs --self-check",
    "proof:vulkan:runtime": "node scripts/gpu-hmr-vulkan-runtime-proof.mjs",
    "proof:vulkan:runtime:self-check": "node scripts/gpu-hmr-vulkan-runtime-proof.mjs --self-check",
    "proof:webgpu:preflight": "node scripts/gpu-hmr-webgpu-preflight.mjs",
    "proof:webgpu:preflight:self-check": "node scripts/gpu-hmr-webgpu-preflight.mjs --self-check",
    "proof:webgpu:runtime-visual": "node scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs",
    "proof:webgpu:runtime-visual:profiled": "node -e \"process.env.SYNTHI_WEBGPU_VISUAL_PROFILE='scripts/profiles/webgpu-wgsl-runtime-profiled-layout.json'; import('./scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs')\"",
    "proof:webgpu:runtime-visual:profiled-hot2": "node -e \"process.env.SYNTHI_WEBGPU_VISUAL_PROFILE='scripts/profiles/webgpu-wgsl-runtime-profiled-layout-hot2.json'; process.env.SYNTHI_WEBGPU_VISUAL_DIFFERENT_EDIT='1'; import('./scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs')\"",
    "proof:webgpu:runtime-visual:self-check": "node scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs --self-check",
    "proof:webgpu:runtime-compute": "node scripts/gpu-hmr-webgpu-runtime-compute-proof.mjs",
    "proof:webgpu:runtime-compute:hot2": "node -e \"process.env.SYNTHI_WEBGPU_COMPUTE_PROFILE='scripts/profiles/webgpu-wgsl-runtime-compute-storage-hot2.json'; process.env.SYNTHI_WEBGPU_COMPUTE_DIFFERENT_EDIT='1'; process.env.SYNTHI_WEBGPU_COMPUTE_METRIC_SCOPE='hot_delta_2'; import('./scripts/gpu-hmr-webgpu-runtime-compute-proof.mjs')\"",
    "proof:webgpu:runtime-compute:self-check": "node scripts/gpu-hmr-webgpu-runtime-compute-proof.mjs --self-check",
    "proof:hip-module:runtime": "node scripts/gpu-hmr-hip-module-runtime-proof.mjs",
    "proof:hip-module:runtime:hot2": "node -e \"process.env.SYNTHI_HIP_MODULE_PROFILE='scripts/profiles/hip-module-runtime-readback-hot2.json'; process.env.SYNTHI_HIP_MODULE_DIFFERENT_EDIT='1'; process.env.SYNTHI_HIP_MODULE_METRIC_SCOPE='hot_delta_2'; import('./scripts/gpu-hmr-hip-module-runtime-proof.mjs')\"",
    "proof:hip-module:runtime:self-check": "node scripts/gpu-hmr-hip-module-runtime-proof.mjs --self-check && node scripts/tests/gpu-hmr-hip-module-runtime-smoke.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright-core": "^1.60.0",
    "sharp": "^0.33.0",
    "werift": "^0.22.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
