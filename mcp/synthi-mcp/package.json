    "scripts/dojo-docker-integration-self-check.mjs",
    "scripts/dojo-governance-lifecycle-self-check.mjs",
    "scripts/dojo-graph-runtime-self-check.mjs",
    "scripts/dojo-hosted-runtime-gateway-self-check.mjs",
    "scripts/dojo-managed-key-signing-self-check.mjs",
    "scripts/dojo-privacy-redaction-self-check.mjs",
    "scripts/dojo-postgres-control-plane-self-check.mjs",
    "scripts/dojo-proof-self-check.mjs",
    "scripts/dojo-release-gate-verify.mjs",
    "scripts/dojo-release-gate-manifest.mjs",
    "scripts/dojo-security-abuse-self-check.mjs",
    "scripts/dojo-source-drift-self-check.mjs",
    "scripts/dojo-vivarium-runtime-self-check.mjs",
    "scripts/dojo-mcp-host-conformance.mjs",
    "scripts/gpu-hmr-validation-matrix-ledger.mjs",
    "scripts/gpu-hmr-webgpu-preflight.mjs",
    "scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs",
