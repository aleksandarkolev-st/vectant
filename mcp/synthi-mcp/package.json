    "scripts/profiles/webgpu/triangle-before.wgsl",
    "scripts/profiles/webgpu/triangle-after.wgsl",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthi-inc/synthi-ide.git",
    "directory": "mcp/synthi-mcp"
  },
  "homepage": "https://github.com/synthi-inc/synthi-ide/tree/main/mcp/synthi-mcp#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "browser:workflow:bridge": "node dist/browser_workflow_bridge/standalone.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:dojo:postgres-control-plane": "vitest run tests/integration/dojo_postgres_schema.test.ts tests/integration/dojo_postgres_proof_store.test.ts tests/integration/dojo_postgres_proof_key_registry.test.ts tests/integration/dojo_evidence_ledger_store.test.ts tests/integration/dojo_audit_store.test.ts tests/integration/dojo_postgres_skill_store.test.ts tests/integration/dojo_postgres_license_store.test.ts tests/integration/dojo_postgres_tool_control_plane.test.ts tests/integration/dojo_postgres_ghost_shadow_evidence_store.test.ts tests/integration/dojo_postgres_governance_store.test.ts tests/integration/dojo_postgres_source_registry_store.test.ts tests/integration/dojo_postgres_mcp_skill_bus_store.test.ts tests/integration/dojo_postgres_graph_run_store.test.ts tests/integration/dojo_postgres_hosted_runtime_store.test.ts tests/integration/dojo_hosted_runtime_gateway_resolver.test.ts tests/integration/dojo_postgres_mcp_host_conformance_store.test.ts tests/integration/dojo_proof_ledger_tool.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/release-smoke.mjs --command dist/index.js",
    "smoke:image": "node scripts/release-smoke.mjs",
    "spike:all": "tsx tests/spike/run_all.ts",
    "spike:E1": "tsx tests/spike/E1_frame_seq.ts",
    "spike:E2": "tsx tests/spike/E2_locator_cache.ts",
    "spike:E2b": "tsx tests/spike/E2b_region_phash.ts",
    "spike:E3": "tsx tests/spike/E3_p99_load.ts",
    "spike:E4": "tsx tests/spike/E4_cost_budget.ts",
    "soak": "node tests/soak/soak_loop.mjs",
    "live:phase3": "node scripts/live-test-phase3.mjs",
    "live:browser": "node scripts/live-browser-smoke.mjs",
    "live:browser:workspace": "node scripts/live-browser-smoke.mjs --workspace",
    "live:browser:workflow-pipeline": "node scripts/workflow-pipeline-e2e.mjs",
    "live:browser:private-tool-stdio": "node scripts/private-tool-stdio-acceptance.mjs",
    "live:browser:private-tool-host-conformance": "node scripts/private-tool-stdio-acceptance.mjs --require-custom-mcp-command --require-non-loopback-runtime --require-external-private-tool-store",
    "live:browser:private-tool-codex": "node scripts/private-tool-codex-acceptance.mjs",
    "live:browser:private-tool-codex-host-conformance": "node scripts/private-tool-codex-acceptance.mjs --require-non-loopback-runtime --require-external-private-tool-store",
    "live:dojo:mcp-host-conformance": "node scripts/dojo-mcp-host-conformance.mjs --require-non-loopback-mcp-host --execute-production --require-external-control-plane-store --require-external-proof-signing --require-bridge-token --require-no-local-cdp --require-licensed-skill-filtering",
    "live:browser:install": "npx playwright-core install chromium",
    "proof:dojo": "node scripts/dojo-proof-self-check.mjs",
    "proof:dojo:self-check": "node scripts/dojo-proof-self-check.mjs",
    "proof:dojo:mcp-host-conformance:self-check": "node scripts/dojo-mcp-host-conformance.mjs --self-check",
    "proof:dojo:docker-integration:self-check": "node scripts/dojo-docker-integration-self-check.mjs",
    "proof:dojo:postgres-control-plane:self-check": "node scripts/dojo-postgres-control-plane-self-check.mjs",
    "proof:dojo:affordance-codemod:self-check": "node scripts/dojo-affordance-codemod-self-check.mjs",
    "proof:dojo:api-tool-compiler:self-check": "node scripts/dojo-api-tool-compiler-self-check.mjs --from-json ../../tmp/dojo-api-tool-compiler/dojo-api-tool-compiler.vitest.json",
    "proof:dojo:source-drift:self-check": "node scripts/dojo-source-drift-self-check.mjs --from-json ../../tmp/dojo-source-drift/dojo-source-drift.vitest.json",
    "proof:dojo:governance-lifecycle:self-check": "node scripts/dojo-governance-lifecycle-self-check.mjs --from-json ../../tmp/dojo-governance-lifecycle/dojo-governance-lifecycle.vitest.json",
    "proof:dojo:graph-runtime:self-check": "node scripts/dojo-graph-runtime-self-check.mjs --from-json ../../tmp/dojo-graph-runtime/dojo-graph-runtime.vitest.json",
    "proof:dojo:hosted-runtime-gateway:self-check": "node scripts/dojo-hosted-runtime-gateway-self-check.mjs --from-json ../../tmp/dojo-hosted-runtime-gateway/dojo-hosted-runtime-gateway.vitest.json",
    "proof:dojo:vivarium-runtime:self-check": "node scripts/dojo-vivarium-runtime-self-check.mjs --from-json ../../tmp/dojo-vivarium-runtime/dojo-vivarium-runtime.vitest.json",
    "proof:dojo:release-gates:self-check": "node scripts/dojo-release-gate-manifest.mjs --self-check",
    "proof:dojo:release-gates:verify": "node scripts/dojo-release-gate-verify.mjs",
    "proof:dojo:release-gates:verify:self-check": "node scripts/dojo-release-gate-verify.mjs --self-check",
    "proof:dojo:managed-key-signing:self-check": "node scripts/dojo-managed-key-signing-self-check.mjs",
    "proof:dojo:security-abuse:self-check": "node scripts/dojo-security-abuse-self-check.mjs",
    "proof:dojo:compliance-export:self-check": "node scripts/dojo-compliance-export-self-check.mjs",
    "proof:dojo:privacy-redaction:self-check": "node scripts/dojo-privacy-redaction-self-check.mjs",
    "proof:dojo:chaos-performance:self-check": "node scripts/dojo-chaos-performance-self-check.mjs",
    "smoke:operator-agents": "node scripts/operator-multi-agent-smoke.mjs",
    "live:lease-contention": "node scripts/live-lease-contention.mjs",
    "proof:real-rocm": "node scripts/gpu-hmr-real-rocm-repo-validation.mjs",
    "proof:real-rocm:warm": "node -e \"process.env.SYNTHI_REAL_ROCM_REUSE_WORKER_REPO='1'; process.env.SYNTHI_REAL_ROCM_CLEAN_BUILD='0'; import('./scripts/gpu-hmr-real-rocm-repo-validation.mjs')\"",
    "proof:runtime-profile": "node scripts/gpu-hmr-runtime-profile-proof.mjs",
    "proof:runtime-profile:self-check": "node scripts/gpu-hmr-runtime-profile-proof.mjs --self-check",
    "proof:adversarial-ledger:self-check": "node scripts/gpu-hmr-adversarial-proof-ledger-self-check.mjs",
    "proof:acceptance-contract:self-check": "node scripts/gpu-hmr-acceptance-contract-self-check.mjs",
    "proof:strict-gates:self-check": "node scripts/gpu-hmr-proof-strict-gates-self-check.mjs",
    "proof:visual-evidence:self-check": "node scripts/tests/gpu-hmr-visual-evidence-smoke.mjs",
    "proof:generated-split-granularity:self-check": "node scripts/tests/gpu-hmr-generated-split-granularity-smoke.mjs",
    "proof:external-project": "node scripts/gpu-hmr-external-project-profile.mjs",
    "proof:external-project:self-check": "node scripts/gpu-hmr-external-project-profile.mjs --self-check",
    "proof:external-project:dry-run": "node scripts/gpu-hmr-external-project-profile.mjs --dry-run",
    "proof:timing-metrics": "node scripts/gpu-hmr-timing-metrics-summary.mjs",
    "proof:validation-matrix": "node scripts/gpu-hmr-validation-matrix-ledger.mjs",
    "proof:validation-matrix:self-check": "node scripts/tests/gpu-hmr-validation-matrix-ledger-smoke.mjs && node scripts/gpu-hmr-validation-matrix-ledger.mjs --self-check",
    "proof:external-project:bevy": "node scripts/gpu-hmr-external-project-profile.mjs --profile mcp/synthi-mcp/scripts/profiles/bevy-wgsl-shader-material.json",
    "proof:timing-metrics:self-check": "node scripts/tests/gpu-hmr-timing-metrics-smoke.mjs && node scripts/gpu-hmr-timing-metrics-summary.mjs --self-check",
    "proof:runtime-profile:hiprt": "node scripts/gpu-hmr-runtime-profile-proof.mjs --profile mcp/synthi-mcp/scripts/profiles/hiprt-megakernel-direct-light-zero.json --mode same-process",
    "proof:runtime-profile:hiprt:camera-rays": "node scripts/gpu-hmr-runtime-profile-proof.mjs --profile mcp/synthi-mcp/scripts/profiles/hiprt-camera-rays-horizontal-mirror.json --mode same-process",
    "proof:hiprt:warm": "node scripts/hiprt-light-math-warm-proof.mjs",
    "proof:hiprt:warm:camera-rays": "node -e \"process.env.SYNTHI_HIPRT_WARM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/hiprt-camera-rays-horizontal-mirror.json'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:hiprt:same-process": "node -e \"process.env.SYNTHI_HIPRT_WARM_MODE='same-process'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:hiprt:same-process:camera-rays": "node -e \"process.env.SYNTHI_HIPRT_WARM_MODE='same-process'; process.env.SYNTHI_HIPRT_WARM_PROFILE_PATH='mcp/synthi-mcp/scripts/profiles/hiprt-camera-rays-horizontal-mirror.json'; import('./scripts/hiprt-light-math-warm-proof.mjs')\"",
    "proof:oidn:preflight": "node scripts/gpu-hmr-oidn-preflight.mjs",
    "proof:oidn:preflight:self-check": "node scripts/gpu-hmr-oidn-preflight.mjs --self-check",
    "proof:opencl:preflight": "node scripts/gpu-hmr-opencl-preflight.mjs",
    "proof:opencl:preflight:self-check": "node scripts/gpu-hmr-opencl-preflight.mjs --self-check",
    "proof:vulkan:preflight": "node scripts/gpu-hmr-vulkan-preflight.mjs",
    "proof:vulkan:preflight:self-check": "node scripts/gpu-hmr-vulkan-preflight.mjs --self-check",
    "proof:webgpu:preflight": "node scripts/gpu-hmr-webgpu-preflight.mjs",
    "proof:webgpu:preflight:self-check": "node scripts/gpu-hmr-webgpu-preflight.mjs --self-check",
    "proof:webgpu:runtime-visual": "node scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs",
    "proof:webgpu:runtime-visual:self-check": "node scripts/gpu-hmr-webgpu-runtime-visual-proof.mjs --self-check"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pg": "^8.21.0",
    "playwright-core": "^1.60.0",
    "sharp": "^0.33.0",
    "werift": "^0.22.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
