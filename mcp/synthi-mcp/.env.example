# Synthi MCP — local .env template.
#
# Copy to `.env` in the same directory (git-ignored by the root
# .gitignore) and fill in the values you need. The MCP bootstrap
# (src/index.ts) loads this file at startup but NEVER overrides
# env vars already set by the host's MCP registration — so production
# deployments are unaffected.
#
# Alternate load paths (first match wins):
#   1. `--env-file=/path/to/.env` CLI arg
#   2. `SYNTHI_ENV_FILE` env var
#   3. `<mcp/synthi-mcp>/.env` (this file's location)

# ── Session / signaling ──────────────────────────────────────────────
# SYNTHI_SESSION_ID=my-dev-session
# SYNTHI_SIGNALING_URL=ws://localhost:9000

# ── Vision backend ───────────────────────────────────────────────────
# Pick one: agent_side (default, no key needed) | claude_api | gemini_api | local | mock
# SYNTHI_VISION_BACKEND=agent_side

# Gemini — needed when SYNTHI_VISION_BACKEND=gemini_api.
# Fallback order inside the gemini backend: GEMINI_API_KEY → GOOGLE_API_KEY.
# GEMINI_API_KEY=
# SYNTHI_GEMINI_MODEL=gemini-2.5-flash

# Anthropic — needed when SYNTHI_VISION_BACKEND=claude_api.
# ANTHROPIC_API_KEY=
# SYNTHI_VISION_MODEL=claude-opus-4-7

# Local — needed when SYNTHI_VISION_BACKEND=local (phase 3).
# HTTP endpoint that accepts {description, hints, frame:{png_base64,width,height}}
# and returns {bbox, confidence, trace?}.
# SYNTHI_LOCAL_VISION_URL=http://127.0.0.1:8080/locate

# ── Observability ────────────────────────────────────────────────────
# SYNTHI_PROMETHEUS_PORT=9464
# SYNTHI_PROMETHEUS_HOST=127.0.0.1

# ── Phase-3 snapshot persistor ──────────────────────────────────────
# When set, synthi_snapshot records survive across MCP subprocess restarts.
# SYNTHI_SNAPSHOT_DIR=.snapshots
