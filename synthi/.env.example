# External MCP tool connections (Plan 1a/1b)
# AUTH_SECRET (already required by NextAuth) also encrypts connection secrets.
# Optional: comma-separated hostnames allowed past the SSRF guard (self-hosted MCP servers).
SYNTHI_MCP_SSRF_ALLOWLIST=
# Optional: per-call timeout for outbound MCP requests (ms; default 20000).
SYNTHI_MCP_CALL_TIMEOUT_MS=
# Plan 1b only: shared secret for synthi-mcp -> /api/internal/mcp/resolve
SYNTHI_INTERNAL_API_TOKEN=

# ── Git providers (Slice 2) ──────────────────────────────────────────
# OAuth apps for hosted providers (web + device flow). Self-hosted/generic use PATs only.
# GitLab OAuth app (redirect URI: ${NEXTAUTH_URL}/api/integrations/git/oauth/gitlab/callback, scopes: api read_user)
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GitHub git-OAuth REUSES NextAuth login's GITHUB_ID / GITHUB_SECRET (see src/app/auth.js) — there is
# no separate GITHUB_CLIENT_ID/SECRET. Set the same OAuth app's credentials here, or connect GitHub
# via PAT instead (no OAuth app needed). If GITHUB_ID is unset, the GitHub git OAuth flow sends an empty client_id.
# GITHUB_ID=
# GITHUB_SECRET=
# Required: used to build OAuth redirect URIs + the post-connect redirect (e.g. https://app.example.com).
# NEXTAUTH_URL=
# Optional: git API rate limit (requests/min per user, default 60)
# SYNTHI_RL_GIT=60

# ── Community-app hosting: submission + review gate (Phase 1) ─────────
# Platform admins for the cross-workspace program-review queue. Comma-separated
# emails, matched (case-insensitive) against the session email. Unset ⇒ nobody
# can approve (fail-closed).
PLATFORM_ADMIN_EMAILS=
# Artifact Registry target for re-hosting approved community images (crane copy,
# pinned by digest). Host/project mirror the deploy config; REPO is a dedicated
# AR repository for community images — provision once:
#   gcloud artifacts repositories create community --repository-format=docker \
#     --location=europe-west10 --project=overview-synti
# VECTANT_AR_HOST=europe-west10-docker.pkg.dev
# VECTANT_AR_PROJECT=overview-synti
# VECTANT_AR_REPO=community
# Optional: trivy CVE gate threshold (UNKNOWN|LOW|MEDIUM|HIGH|CRITICAL; default HIGH).
# PROGRAM_SCAN_THRESHOLD=HIGH
# Phase 2: enable the advisory AI auto-approve/triage layer (calls the ai-engine
# POST /programs/risk-review). Default off ⇒ every clean submission goes to the
# manual queue (Phase-1 behavior). Auto-approve is conservative (low risk + no
# sensitive scopes + no flags); the AI is never a load-bearing security control.
# PROGRAM_AI_REVIEW_ENABLED=false
# PROGRAM_AI_RISK_THRESHOLD=0.3
