# External MCP tool connections (Plan 1a/1b)
# AUTH_SECRET (already required by NextAuth) also encrypts connection secrets.
# Optional: comma-separated hostnames allowed past the SSRF guard (self-hosted MCP servers).
SYNTHI_MCP_SSRF_ALLOWLIST=
# Optional: per-call timeout for outbound MCP requests (ms; default 20000).
SYNTHI_MCP_CALL_TIMEOUT_MS=
# Plan 1b only: shared secret for synthi-mcp -> /api/internal/mcp/resolve
SYNTHI_INTERNAL_API_TOKEN=

# ── Git providers (Slice 2) ──────────────────────────────────────────
# OAuth apps for hosted providers (web + device flow). Self-hosted/generic use PATs only.
# GitLab OAuth app (redirect URI: ${NEXTAUTH_URL}/api/integrations/git/oauth/gitlab/callback, scopes: api read_user)
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GitHub git-OAuth REUSES NextAuth login's GITHUB_ID / GITHUB_SECRET (see src/app/auth.js) — there is
# no separate GITHUB_CLIENT_ID/SECRET. Set the same OAuth app's credentials here, or connect GitHub
# via PAT instead (no OAuth app needed). If GITHUB_ID is unset, the GitHub git OAuth flow sends an empty client_id.
# GITHUB_ID=
# GITHUB_SECRET=
# Required: used to build OAuth redirect URIs + the post-connect redirect (e.g. https://app.example.com).
# NEXTAUTH_URL=
# Optional: git API rate limit (requests/min per user, default 60)
# SYNTHI_RL_GIT=60
