{
  "name": "hello-world",
  "displayName": "Hello World",
  "description": "A test extension for Synthi IDE extension system",
  "version": "1.0.0",
  "publisher": "synthi",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./hello-world-extension.js",
  "contributes": {
    "commands": [
      {
        "command": "helloWorld.sayHello",
        "title": "Hello World: Say Hello"
      },
      {
        "command": "helloWorld.openWebview",
        "title": "Hello World: Open Webview"
      }
    ]
  }
}
