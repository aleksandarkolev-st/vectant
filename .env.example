# Copy to .env.local for docker compose. Never commit .env.local.

# Auth
NEXTAUTH_SECRET=
AUTH_SECRET=
GATEWAY_JWT_SECRET=
# Local browser-MCP workspace harness only. Keep unset outside disposable dev stacks.
NEXT_PUBLIC_SYNTHI_WORKSPACE_AUTH_BYPASS=
NEXT_PUBLIC_SYNTHI_LOOPBACK_AUTH_BRIDGE_PATH=/auth/loopback

# Database
DATABASE_URL=postgres://synthi:password@postgres:5432/synthi
POSTGRES_HOST_PORT=5432

# OAuth providers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GCP storage
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# AI providers
AI_BACKEND_AUTH_TOKEN=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Production browser workflow bridge. Leave URL empty in Kubernetes; the
# Next.js proxy routes to the runtime-scoped bridge service from the template.
SYNTHI_BROWSER_WORKFLOW_BRIDGE_URL=
SYNTHI_BROWSER_WORKFLOW_BRIDGE_TARGET_TEMPLATE=
SYNTHI_BROWSER_WORKFLOW_BRIDGE_PORT=9466
SYNTHI_HOSTED_BROWSER_CDP_PORT=9222
SYNTHI_BROWSER_WORKFLOW_BRIDGE_TOKEN=
SYNTHI_PRIVATE_WORKFLOW_TOOL_STORE_KEY=
SYNTHI_AUTH_CHECKPOINT_STORE_KEY=

# Stable HMAC secret for rt-... runtime pod/service names. Do not rotate
# casually in production because runtime service names and preview routes change.
SYNTHI_RUNTIME_ID_SECRET=

# Terminal CLI OAuth/browser flows that redirect back to localhost inside the
# runtime pod. These limits are operational knobs, not provider-specific values.
SYNTHI_RUNTIME_CALLBACK_BODY_LIMIT_BYTES=65536
SYNTHI_RUNTIME_CALLBACK_RESPONSE_LIMIT_BYTES=131072
SYNTHI_RUNTIME_CALLBACK_BODY_PREVIEW_CHARS=2000
SYNTHI_RUNTIME_CALLBACK_TIMEOUT_MS=15000
SYNTHI_OAUTH_RELAY_SECRET=
SYNTHI_OAUTH_RELAY_TTL_MS=300000
SYNTHI_PREVIEW_SIDECAR_TIMEOUT_MS=30000
SYNTHI_BROWSER_EXTERNAL_OPEN_BODY_LIMIT_BYTES=20000
SYNTHI_BROWSER_EXTERNAL_OPEN_TIMEOUT_MS=15000
