# Copy to .env.local for docker compose. Never commit .env.local.

# Auth
NEXTAUTH_SECRET=
AUTH_SECRET=
GATEWAY_JWT_SECRET=
# Local browser-MCP workspace harness only. Keep unset outside disposable dev stacks.
NEXT_PUBLIC_SYNTHI_WORKSPACE_AUTH_BYPASS=

# CodeSite transaction-activity bridge. Generate a unique high-entropy value
# for each environment; frontend and collab-server must receive the same value.
COLLAB_INTERNAL_TOKEN=

# Database
DATABASE_URL=postgres://synthi:password@postgres:5432/synthi
POSTGRES_HOST_PORT=15432

# Local TURN. Windows/Hyper-V commonly reserves UDP 49152+ ranges, so keep the
# relay range configurable and outside those defaults for local Docker stacks.
COTURN_HOST_PORT=3478
COTURN_RELAY_PORT_MIN=40000
COTURN_RELAY_PORT_MAX=40049

# OAuth providers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GCP storage
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# AI providers
AI_BACKEND_AUTH_TOKEN=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Production browser workflow bridge. Leave URL empty in Kubernetes; the
# Next.js proxy routes to the runtime-scoped bridge service from the template.
SYNTHI_BROWSER_WORKFLOW_BRIDGE_URL=
SYNTHI_BROWSER_WORKFLOW_BRIDGE_TARGET_TEMPLATE=
SYNTHI_BROWSER_WORKFLOW_BRIDGE_PORT=9466
SYNTHI_PREVIEW_DISCOVERY_PORTS=
SYNTHI_PREVIEW_SCAN_PORTS=
SYNTHI_HOSTED_BROWSER_CDP_PORT=9222
SYNTHI_BROWSER_WORKFLOW_BRIDGE_TOKEN=
SYNTHI_PRIVATE_WORKFLOW_TOOL_STORE_KEY=
SYNTHI_AUTH_CHECKPOINT_STORE_KEY=

# CodeSite managed-agent landing. These values are consumed only by the
# trusted ai-engine controller; do not pass the access token into harnesses.
# The overlay root must be an existing dedicated directory on collab-data,
# owned by the controller/runtime group and outside every workspace checkout.
SYNTHI_CODESITE_AGENT_OVERLAY_ROOT=
# HTTPS origin of the Synthi control plane, for example https://app.example.com
SYNTHI_CODESITE_CONTROL_PLANE_URL=
# JSON argv executed in an isolated integration worktree before landing.
# Example: ["npm","test","--","--runInBand"]
SYNTHI_CODESITE_FINALIZER_COMMAND=

# CodeSite runtime routing and bounded operational tuning. COLLAB_SERVER_URL
# must name the trusted collaboration service in every deployed environment;
# CodeSite deliberately has no localhost fallback.
COLLAB_SERVER_URL=
SYNTHI_COLLAB_INTERNAL_TOKEN=
SYNTHI_CODESITE_ACTIVITY_NOTIFICATION_TIMEOUT_MS=1500
SYNTHI_CODESITE_READINESS_TIMEOUT_MS=3000
SYNTHI_CODESITE_INBOX_DELIVERY_TIMEOUT_MS=1500
SYNTHI_CODESITE_INSPECTION_TIMEOUT_MS=30000
SYNTHI_CODESITE_INSPECTION_MAX_TIMEOUT_MS=120000
SYNTHI_CODESITE_SHADOW_RUNNER_TIMEOUT_MS=120000
SYNTHI_CODESITE_REPO_SCAN_MAX_FILES=12000
SYNTHI_CODESITE_SNAPSHOT_MAX_FILES=512
SYNTHI_CODESITE_SNAPSHOT_MAX_FILE_BYTES=2097152
SYNTHI_CODESITE_SNAPSHOT_MAX_SCAN_ENTRIES=15000
SYNTHI_CODESITE_ARTIFACT_PATH_HISTORY_MAX_BYTES=4194304
SYNTHI_CODESITE_MAX_ACTIVE_CHANNELS=3

# Proof signing. Production requires one explicit authority, preferably an
# Ed25519 key pair. Never rely on AUTH_SECRET/NEXTAUTH_SECRET as proof keys.
SYNTHI_CODESITE_PROOF_AUTHORITY_KEY_ID=
SYNTHI_CODESITE_PROOF_AUTHORITY_NAME=
SYNTHI_CODESITE_PROOF_AUTHORITY_SECRET=
SYNTHI_CODESITE_PROOF_AUTHORITY_PRIVATE_KEY_PEM=
SYNTHI_CODESITE_PROOF_AUTHORITY_PUBLIC_KEY_PEM=
SYNTHI_CODESITE_PROOF_AUTHORITY_PUBLIC_KEYS_JSON=
SYNTHI_CODESITE_PROOF_REQUIRE_TRUSTED_AUTHORITY=1

# Stable HMAC secret for rt-... runtime pod/service names. Do not rotate
# casually in production because runtime service names and preview routes change.
SYNTHI_RUNTIME_ID_SECRET=
