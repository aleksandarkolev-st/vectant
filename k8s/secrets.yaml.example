# ─────────────────────────────────────────────────────────────────────────────
#  Synthi IDE — Secrets (EXAMPLE / TEMPLATE)
# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to secrets.yaml and fill in the real base64 values:
#
#    cp secrets.yaml.example secrets.yaml
#
#  Encode a value:   echo -n 'my-secret' | base64
#
#  secrets.yaml is gitignored — it will NOT be committed.
#  In production, use GCP Secret Manager + External Secrets Operator instead.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: synthi-secrets
  namespace: synthi
  labels:
    app.kubernetes.io/part-of: synthi-ide
type: Opaque
data:
  # ── PostgreSQL (via Cloud SQL Auth Proxy sidecar) ─────────────────────────
  # echo -n 'postgresql://synthi:PASSWORD@127.0.0.1:5432/synthi' | base64
  DATABASE_URL: CHANGEME_BASE64
  POSTGRES_USER: CHANGEME_BASE64
  POSTGRES_PASSWORD: CHANGEME_BASE64
  POSTGRES_DB: CHANGEME_BASE64

  # ── NextAuth / OAuth ────────────────────────────────────────────────────────
  AUTH_SECRET: CHANGEME_BASE64
  NEXTAUTH_SECRET: CHANGEME_BASE64
  GOOGLE_CLIENT_ID: CHANGEME_BASE64
  GOOGLE_CLIENT_SECRET: CHANGEME_BASE64
  GITHUB_ID: CHANGEME_BASE64
  GITHUB_SECRET: CHANGEME_BASE64

  # ── GCS (Google Cloud Storage) ──────────────────────────────────────────────
  GCP_CLIENT_EMAIL: CHANGEME_BASE64
  GCP_PRIVATE_KEY: CHANGEME_BASE64

  # ── Cloudflare TURN ─────────────────────────────────────────────────────────
  CLOUDFLARE_TURN_TOKEN_ID: CHANGEME_BASE64
  CLOUDFLARE_TURN_API_TOKEN: CHANGEME_BASE64

  # ── AI Provider Keys ────────────────────────────────────────────────────────
  AI_BACKEND_AUTH_TOKEN: CHANGEME_BASE64
  # Stable HMAC secret for runtime pod/service names. Do not rotate casually.
  SYNTHI_RUNTIME_ID_SECRET: CHANGEME_BASE64
  # Base64-encoded 32-byte key for collab-server disk token encryption.
  SYNTHI_TOKEN_ENCRYPTION_KEY: CHANGEME_BASE64
  GEMINI_API_KEY: CHANGEME_BASE64
  OPENAI_API_KEY: CHANGEME_BASE64
