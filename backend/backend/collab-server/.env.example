# ─────────────────────────────────────────────────────────────────────────────
# Collab-Server Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in production values.
# All variables are optional – the defaults shown here are suitable for local
# development.  See config.js for the canonical parsing logic.
# ─────────────────────────────────────────────────────────────────────────────

# ── Paths ─────────────────────────────────────────────────────────────────────
# Root directory that holds per-workspace git repositories (one sub-dir per
# workspace slug).  Accepts absolute or relative paths.
REPOS_DIR=./repos

# Directory used by y-leveldb for Yjs CRDT document persistence.
# DEPRECATED: No longer used — CRDT persistence is handled by Y-Sweet.
# LEVELDB_DIR=./data/collab-leveldb

# ── Y-Sweet CRDT Server ──────────────────────────────────────────────────────
# URL of the Y-Sweet server that handles Yjs document persistence + sync.
YSWEET_URL=http://localhost:8080

# Optional auth key for Y-Sweet. Leave empty for local development.
YSWEET_AUTH_KEY=

# ── Networking ────────────────────────────────────────────────────────────────
# Port the collab WebSocket + HTTP server listens on.
COLLAB_PORT=1234

# Base URL of the code-intelligence / AI-engine backend.
# Trailing slashes are stripped automatically.
CODE_INTEL_URL=http://localhost:8000
AI_BACKEND_AUTH_TOKEN=

# Allowed CORS origin for the HTTP API.
CORS_ORIGIN=http://localhost:3000

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# GCS project ID.
GCP_PROJECT_ID=overview-synti

# GCS bucket name.
GCS_BUCKET_NAME=synthi-cloud-storage

# Service-account credentials (option A – individual fields):
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Service-account credentials (option B – full JSON string).
# When set, this takes precedence over CLIENT_EMAIL / PRIVATE_KEY above.
GCP_CREDENTIALS=

# Prefix inside the GCS bucket under which workspace files are stored.
# Files are uploaded as  <prefix>/<slug>/<relative-path>.
GCS_WORKSPACE_PREFIX=workspaces

# ── Feature flags ─────────────────────────────────────────────────────────────
# Sync files to GCS on explicit save (sync action).  Set to "false"
# to disable (e.g. in offline / local-only setups).
GCS_SYNC_ON_FLUSH=true

# Trigger incremental code-intelligence indexing after each auto-flush.
CODE_INTEL_AUTO_INDEX=true

# ── Flush tuning ─────────────────────────────────────────────────────────
# Debounce interval (ms) before CRDT changes are flushed to disk on save.
FLUSH_DEBOUNCE_MS=150

# ── TURN credentials (Cloudflare Calls) ───────────────────────────────────────
# Short-lived TURN relay credentials are fetched from Cloudflare Calls.
# Both the Next.js API route (/api/turn-credentials) and the collab-server
# internal endpoint (/turn-credentials) use these values.
#
# Create a TURN token at:
#   https://dash.cloudflare.com  →  Calls  →  TURN Keys  →  Generate
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Credential lifetime in seconds.  Default: 86400 (24 h).
# Credentials are cached server-side and refreshed when 80% of TTL has elapsed.
TURN_CREDENTIAL_TTL=86400
