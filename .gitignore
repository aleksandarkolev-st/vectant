# ─────────────────────────────────────────────────────────────────────────────
#  Synthi IDE — Root .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets (NEVER commit real credentials) ─────────────────────────────────
k8s/secrets.yaml
.env
.env.*
!.env.example

# ── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── Build artifacts ─────────────────────────────────────────────────────────
*.log
docker-compose.gpu-*.generated.yml
mcp/synthi-mcp/.gpu-hmr-test-logs/
mcp/synthi-mcp/.gpu-hmr-test-artifacts/

# Vitest cache inside the vendored root node_modules (phase-3 soak + live-
# test harnesses drive vitest at the repo root).
node_modules/.vite/

CLAUDE.md
