{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeSite InspectionRun",
  "type": "object",
  "required": [
    "displayCallsign",
    "status"
  ],
  "properties": {
    "executionPlanId": {
      "type": [
        "string",
        "null"
      ]
    },
    "displayCallsign": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "changedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inspectionSignals": {
      "type": "array"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
