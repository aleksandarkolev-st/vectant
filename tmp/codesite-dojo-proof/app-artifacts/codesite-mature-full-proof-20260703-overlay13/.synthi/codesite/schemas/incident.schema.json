{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeSite Incident",
  "type": "object",
  "required": [
    "severity",
    "category",
    "replayDigest"
  ],
  "properties": {
    "severity": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "participants": {
      "type": "array"
    },
    "affectedZones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incidentReplay": {
      "type": "object"
    },
    "replayDigest": {
      "type": "string"
    },
    "timelineEventRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policyDelta": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
