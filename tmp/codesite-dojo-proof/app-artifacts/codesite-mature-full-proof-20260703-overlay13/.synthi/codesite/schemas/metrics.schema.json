  "title": "CodeSite Metrics",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "sections",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspaceSlug": {
      "type": [
        "string",
        "null"
      ]
    },
    "generatedAt": {
      "type": "string"
    },
    "sections": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
