[
  {
    "zoneKey": "class_a",
    "label": "Critical controlled airspace",
    "class": "A",
    "paths": [
      "api/auth/**",
      "billing/**",
      "db/migrations/**",
      "infra/prod/**",
      "infra/production/**",
      "**/.env",
      "**/.env.*"
