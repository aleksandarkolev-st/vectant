{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeSite MutationTransaction",
  "type": "object",
  "required": [
    "mutationLeaseId",
    "baseSnapshot",
    "isolation",
    "status"
  ],
  "properties": {
    "mutationLeaseId": {
      "type": "string"
    },
    "baseSnapshot": {
      "type": "string"
    },
    "baseSnapshotEvidence": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "read_set",
            "repo_wide"
          ]
        },
        "snapshotDigest": {
          "type": "string"
        },
        "evidenceDigest": {
          "type": "string"
        },
        "repoManifestDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "repoManifestFileCount": {
          "type": "number"
        },
        "repoManifestScannedEntries": {
          "type": "number"
        },
        "repoManifestTruncated": {
          "type": "boolean"
        },
        "repoManifestSkippedPaths": {
          "type": "array"
        },
        "readSet": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fileDigests": {
          "type": "array"
        },
        "skippedPaths": {
          "type": "array"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "isolation": {
      "type": "string",
      "enum": [
        "serializable"
      ]
    },
    "status": {
      "type": "string"
    },
    "readSet": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writeSet": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
